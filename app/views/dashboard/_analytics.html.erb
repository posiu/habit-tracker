<% if @stats %>
  <% summary = @stats[:summary] %>
  <div class="bg-white shadow rounded-lg mb-8" id="analytics">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-medium text-gray-900">Analytics</h2>
        <p class="mt-1 text-sm text-gray-600">Last <%= @stats[:period][:days] %> days compared with the previous period</p>
      </div>
      <div class="space-x-2 text-sm">
        <% [7, 30, 90].each do |d| %>
          <%= link_to "#{d}d", root_path(days: d),
                class: "px-2 py-1 rounded #{@stats[:period][:days] == d ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-700'}" %>
        <% end %>
      </div>
    </div>

    <div class="p-6">
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" data-testid="stats-summary">
        <div><dt class="text-sm text-gray-500">Completions</dt><dd class="text-2xl font-semibold"><%= summary[:completions] %></dd></div>
        <div>
          <dt class="text-sm text-gray-500">vs. previous period</dt>
          <dd class="text-2xl font-semibold">
            <%= summary[:change_percent] ? "#{'+' if summary[:change_percent] > 0}#{summary[:change_percent]}%" : '—' %>
          </dd>
        </div>
        <div><dt class="text-sm text-gray-500">Active days</dt><dd class="text-2xl font-semibold"><%= summary[:active_days] %> <span class="text-sm text-gray-500">(<%= summary[:active_day_rate] %>%)</span></dd></div>
        <div><dt class="text-sm text-gray-500">Average mood</dt><dd class="text-2xl font-semibold"><%= summary[:average_mood] || '—' %></dd></div>
      </dl>

      <% if @insights.any? %>
        <ul class="mb-6 space-y-2" data-testid="insights">
          <% @insights.each do |insight| %>
            <li class="text-sm rounded px-3 py-2 <%= { positive: 'bg-green-50 text-green-800', warning: 'bg-yellow-50 text-yellow-800' }.fetch(insight[:type], 'bg-blue-50 text-blue-800') %>">
              <%= insight[:message] %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div><h3 class="text-sm font-medium text-gray-700 mb-2">Daily completions</h3><canvas id="chart-daily" height="140"></canvas></div>
        <div><h3 class="text-sm font-medium text-gray-700 mb-2">Weekly trend (12 weeks)</h3><canvas id="chart-weekly" height="140"></canvas></div>
        <div><h3 class="text-sm font-medium text-gray-700 mb-2">Best weekdays</h3><canvas id="chart-weekday" height="140"></canvas></div>
        <div><h3 class="text-sm font-medium text-gray-700 mb-2">Goal progress (%)</h3><canvas id="chart-goals" height="140"></canvas></div>
      </div>

      <% if @stats[:habits].any? %>
        <h3 class="text-sm font-medium text-gray-700 mt-6 mb-2">Habits</h3>
        <table class="min-w-full text-sm" data-testid="habit-stats">
          <thead><tr class="text-left text-gray-500"><th class="py-1">Habit</th><th>Completions</th><th>Rate</th><th>Streak</th></tr></thead>
          <tbody>
            <% @stats[:habits].each do |h| %>
              <tr class="border-t"><td class="py-1"><%= h[:name] %></td><td><%= h[:completions] %></td><td><%= h[:completion_rate] %>%</td><td><%= h[:current_streak] %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>

  <script type="application/json" id="analytics-data"><%= raw json_escape(@stats.to_json) %></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
    (function () {
      if (typeof Chart === 'undefined') return;
      var data = JSON.parse(document.getElementById('analytics-data').textContent);
      function make(id, type, labels, values, label, color) {
        var el = document.getElementById(id);
        if (!el) return;
        new Chart(el, {
          type: type,
          data: { labels: labels, datasets: [{ label: label, data: values, backgroundColor: color + '99', borderColor: color, tension: 0.3, fill: type === 'line' }] },
          options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
      }
      make('chart-daily', 'bar', data.daily_series.map(function (d) { return d.date; }), data.daily_series.map(function (d) { return d.completions; }), 'Completions', '#4f46e5');
      make('chart-weekly', 'line', data.weekly_trend.map(function (d) { return d.week_start; }), data.weekly_trend.map(function (d) { return d.completions; }), 'Completions', '#059669');
      make('chart-weekday', 'bar', data.weekday_distribution.map(function (d) { return d.weekday.slice(0, 3); }), data.weekday_distribution.map(function (d) { return d.completions; }), 'Completions', '#d97706');
      make('chart-goals', 'bar', data.goals.map(function (g) { return g.name; }), data.goals.map(function (g) { return g.percentage; }), 'Progress %', '#2563eb');
    })();
  </script>
<% end %>
