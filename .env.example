# Copy to .env (never commit it) or set these in your hosting platform.
RAILS_ENV=production
SECRET_KEY_BASE=            # bundle exec rails secret  (also signs API JWTs)
DATABASE_URL=postgres://habit_tracker:password@db:5432/habit_tracker_production
REDIS_URL=redis://redis:6379/0
APP_HOST=habits.example.com
ALLOWED_HOSTS=habits.example.com
CORS_ORIGINS=                # comma separated origins allowed to call /api (empty = none)
MAILER_FROM=no-reply@habits.example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
