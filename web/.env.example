NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Admin panel (invitations): service key from `npx supabase status -o env` (SECRET_KEY),
# comma-separated e-mails allowed to invite and delete users.
SUPABASE_SECRET_KEY=
ADMIN_EMAILS=
# "true" re-enables the public /signup page (local development and e2e tests only).
ALLOW_PUBLIC_SIGNUP=
